# =============================================================================
# PATHS & CONSTANTS
# =============================================================================
XDG_CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
XDG_DATA_HOME = Path(
    os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
)
CONFIG_DIR = XDG_CONFIG_HOME / "browser-dispatch"
CONFIG_PATH = CONFIG_DIR / "config.json"
DESKTOP_FILE_PATH = XDG_DATA_HOME / "applications" / "browser-dispatch.desktop"
MIMEAPPS_PATH = XDG_CONFIG_HOME / "mimeapps.list"

# =============================================================================
# CONFIG MANAGEMENT
# =============================================================================

DEFAULT_CONFIG: dict = {
    "default_browser": "",
    "previous_default": "",
    "rules": [],
}


def load_config() -> dict:
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH) as f:
                data = json.load(f)
            for k, v in DEFAULT_CONFIG.items():
                data.setdefault(k, v)
            return data
        except (json.JSONDecodeError, OSError):
            pass
    return DEFAULT_CONFIG.copy()


def save_config(config: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    with open(CONFIG_PATH, "w") as f:
        json.dump(config, f, indent=2)


# =============================================================================
# BROWSER DETECTION
# =============================================================================

def _parse_exec(exec_str: str) -> list[str]:
    """Parse Exec field, removing %u/%U/%f/%F field codes."""
    parts = exec_str.split()
    return [p for p in parts if not (len(p) == 2 and p.startswith("%"))]


def _parse_desktop_file(path: Path) -> Optional[dict]:
    """Parse a .desktop file; return browser info dict or None if not a browser."""
    cp = configparser.RawConfigParser()
    cp.optionxform = str  # preserve case
    try:
        cp.read(str(path), encoding="utf-8")
    except Exception:
        return None

    if not cp.has_section("Desktop Entry"):
        return None

    entry = cp["Desktop Entry"]
    name = entry.get("Name", "").strip()

    # Skip our own dispatcher
    if name == "Browser Dispatch":
        return None

    # Skip hidden / NoDisplay entries that aren't browsers
    no_display = entry.get("NoDisplay", "false").strip().lower()
    categories = entry.get("Categories", "")
    mime_type = entry.get("MimeType", "")

    # Require x-scheme-handler/http in MimeType — this is the definitive indicator
    # that an app can actually open URLs. WebBrowser in Categories alone is not
    # reliable (e.g. KDE's bookmark editor also has it but doesn't handle URLs).
    if "x-scheme-handler/http" not in mime_type:
        return None

    exec_str = entry.get("Exec", "").strip()
    exec_parts = _parse_exec(exec_str)
    if not exec_parts:
        return None

    return {
        "name": name,
        "exec": exec_parts[0],
        "exec_args": exec_parts,
        "desktop_file": path.name,
    }


def detect_browsers() -> dict[str, dict]:
    """Return dict of {display_name: browser_info} for all detected browsers."""
    search_dirs = [
        Path("/usr/share/applications"),
        XDG_DATA_HOME / "applications",
    ]
    browsers: dict[str, dict] = {}
    seen_desktops: set[str] = set()

    for search_dir in search_dirs:
        if not search_dir.exists():
            continue
        for desktop_file in sorted(search_dir.glob("*.desktop")):
            if desktop_file.name in seen_desktops:
                continue
            info = _parse_desktop_file(desktop_file)
            if info:
                browsers[info["name"]] = info
                seen_desktops.add(desktop_file.name)

    return browsers


# =============================================================================
# RULE MATCHING
# =============================================================================

def match_url(url: str, config: dict) -> tuple[str, Optional[dict]]:
    """
    Match URL against rules in order. Returns (browser_name, matched_rule | None).
    Falls back to default_browser if no rule matches.
    """
    try:
        hostname = urlparse(url).hostname or ""
    except Exception:
        hostname = ""

    for rule in config.get("rules", []):
        pattern = rule.get("pattern", "")
        rule_type = rule.get("type", "glob")
        matched = False

        if rule_type == "glob":
            matched = fnmatch.fnmatch(hostname, pattern)
        elif rule_type == "regex":
            try:
                matched = bool(re.search(pattern, hostname))
            except re.error:
                pass

        if matched:
            return rule.get("browser", ""), rule

    return config.get("default_browser", ""), None


# =============================================================================
# DISPATCHER
# =============================================================================

def dispatch(url: str) -> None:
    """Route a URL to the appropriate browser based on configured rules."""
    config = load_config()
    browser_name, _ = match_url(url, config)
    browsers = detect_browsers()

    cmd: list[str] = []

    if browser_name and browser_name in browsers:
        cmd = browsers[browser_name]["exec_args"] + [url]
    elif browser_name:
        # Try as a bare command (e.g. "firefox")
        cmd = [browser_name, url]
    else:
        print(
            f"browser-dispatch: no browser configured. Set a default in --config.",
            file=sys.stderr,
        )
        sys.exit(1)

    subprocess.Popen(cmd)


# =============================================================================
# INSTALLER
# =============================================================================

def is_installed() -> bool:
    return DESKTOP_FILE_PATH.exists()


def _read_mimeapps() -> configparser.RawConfigParser:
    # strict=False: mimeapps.list can have duplicate keys (e.g. written by
    # different tools with/without spaces around =); we just keep the last value.
    cp = configparser.RawConfigParser(strict=False)
    cp.optionxform = str
    if MIMEAPPS_PATH.exists():
        cp.read(str(MIMEAPPS_PATH), encoding="utf-8")
    return cp


def _write_mimeapps(cp: configparser.RawConfigParser) -> None:
    MIMEAPPS_PATH.parent.mkdir(parents=True, exist_ok=True)
    with open(MIMEAPPS_PATH, "w") as f:
        cp.write(f)


def get_current_default() -> str:
    cp = _read_mimeapps()
    if cp.has_section("Default Applications"):
        handler = cp["Default Applications"].get("x-scheme-handler/http", "")
        return handler.strip().rstrip(";")
    return ""


def install_as_default() -> None:
    config = load_config()

    # Save previous default so we can restore it
    current = get_current_default()
    if current and current != "browser-dispatch.desktop":
        config["previous_default"] = current
        save_config(config)

    # Write .desktop file
    DESKTOP_FILE_PATH.parent.mkdir(parents=True, exist_ok=True)
    desktop_content = (
        "[Desktop Entry]\n"
        "Version=1.0\n"
        "Type=Application\n"
        "Name=Browser Dispatch\n"
        "GenericName=Web Browser Dispatcher\n"
        f"Exec={SCRIPT_FILE} %u\n"
        "Terminal=false\n"
        "NoDisplay=true\n"
        "MimeType=x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/ftp;\n"
        "StartupNotify=false\n"
    )
    DESKTOP_FILE_PATH.write_text(desktop_content)

    # Update mimeapps.list
    cp = _read_mimeapps()
    if not cp.has_section("Default Applications"):
        cp.add_section("Default Applications")
    for scheme in ("x-scheme-handler/http", "x-scheme-handler/https"):
        cp["Default Applications"][scheme] = "browser-dispatch.desktop"
    _write_mimeapps(cp)

    # Update desktop database and xdg-settings (best-effort)
    for cmd in (
        ["update-desktop-database", str(XDG_DATA_HOME / "applications")],
        ["xdg-settings", "set", "default-web-browser", "browser-dispatch.desktop"],
    ):
        try:
            subprocess.run(cmd, check=False, capture_output=True)
        except FileNotFoundError:
            pass


def uninstall_as_default() -> None:
    config = load_config()
    previous = config.get("previous_default", "")

    # Remove desktop file
    if DESKTOP_FILE_PATH.exists():
        DESKTOP_FILE_PATH.unlink()

    # Restore or clear mimeapps entries
    cp = _read_mimeapps()
    if not cp.has_section("Default Applications"):
        cp.add_section("Default Applications")

    if previous:
        for scheme in ("x-scheme-handler/http", "x-scheme-handler/https"):
            cp["Default Applications"][scheme] = previous
        try:
            subprocess.run(
                ["xdg-settings", "set", "default-web-browser", previous],
                check=False,
                capture_output=True,
            )
        except FileNotFoundError:
            pass
    else:
        for scheme in ("x-scheme-handler/http", "x-scheme-handler/https"):
            if cp.has_option("Default Applications", scheme):
                val = cp["Default Applications"][scheme].strip().rstrip(";")
                if val == "browser-dispatch.desktop":
                    cp.remove_option("Default Applications", scheme)

    _write_mimeapps(cp)

    # Update desktop database
    try:
        subprocess.run(
            ["update-desktop-database", str(XDG_DATA_HOME / "applications")],
            check=False,
            capture_output=True,
        )
    except FileNotFoundError:
        pass


