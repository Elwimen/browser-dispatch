class BrowserDispatchApp(App):
    TITLE = "Browser Dispatch"
    SUB_TITLE = "Route URLs to browsers by domain rules"

    DEFAULT_CSS = """
    Screen {
        layout: vertical;
    }
    #main {
        layout: vertical;
        padding: 1 2;
    }
    #rules-header {
        text-style: bold;
        margin-bottom: 0;
    }
    #rules-hint {
        color: $text-muted;
        margin-bottom: 1;
    }
    DataTable {
        height: 1fr;
        border: solid $primary;
    }
    #bottom {
        layout: horizontal;
        height: auto;
        margin-top: 1;
        padding-top: 1;
        border-top: solid $primary-darken-2;
    }
    #default-section {
        width: 1fr;
        layout: vertical;
        height: auto;
    }
    #default-section Label {
        text-style: bold;
    }
    #default-select {
        width: 36;
    }
    #status-section {
        width: 1fr;
        layout: vertical;
        height: auto;
        align: right top;
    }
    #status-label {
        text-align: right;
    }
    """

    BINDINGS = [
        Binding("a", "add_rule", "Add rule"),
        Binding("e", "edit_rule", "Edit rule"),
        Binding("d", "delete_rule", "Delete rule"),
        Binding("ctrl+up", "move_up", "Move up"),
        Binding("ctrl+down", "move_down", "Move down"),
        Binding("t", "test_url", "Test URL"),
        Binding("i", "install", "Install"),
        Binding("u", "uninstall", "Uninstall"),
        Binding("q", "quit_app", "Quit"),
    ]

    def __init__(self) -> None:
        super().__init__()
        self.config = load_config()
        self.browsers = detect_browsers()

    def compose(self) -> ComposeResult:
        yield Header()
        with Container(id="main"):
            yield Label("Rules  —  first match wins", id="rules-header")
            yield Label("Ctrl+↑/↓ to reorder  ·  a=add  e=edit  d=delete  t=test  i=install  u=uninstall", id="rules-hint")
            yield DataTable(id="rules-table", zebra_stripes=True, cursor_type="row")
            with Horizontal(id="bottom"):
                with Vertical(id="default-section"):
                    yield Label("Default browser (fallback):")
                    browser_opts = self._browser_opts()
                    valid_names = {v for _, v in browser_opts}
                    saved = self.config.get("default_browser", "")
                    default_val = saved if saved in valid_names else (
                        browser_opts[0][1] if browser_opts else Select.BLANK
                    )
                    yield Select(
                        browser_opts,
                        value=default_val,
                        id="default-select",
                        allow_blank=True,
                    )
                with Vertical(id="status-section"):
                    yield Static(self._status_text(), id="status-label")
        yield Footer()

    def _browser_opts(self) -> list[tuple[str, str]]:
        return [(name, name) for name in sorted(self.browsers.keys())]

    def _status_text(self) -> str:
        if is_installed():
            return "[green]● Installed as default browser[/green]"
        return "[yellow]○ Not installed as default browser[/yellow]"

    def on_mount(self) -> None:
        table = self.query_one("#rules-table", DataTable)
        table.add_columns("#", "Pattern", "Type", "Browser")
        self._refresh_table()

    def _refresh_table(self, keep_cursor: int = 0) -> None:
        table = self.query_one("#rules-table", DataTable)
        table.clear()
        for i, rule in enumerate(self.config["rules"], 1):
            table.add_row(
                str(i),
                rule.get("pattern", ""),
                rule.get("type", "glob"),
                rule.get("browser", ""),
            )
        if self.config["rules"]:
            row = min(keep_cursor, len(self.config["rules"]) - 1)
            table.move_cursor(row=row)

    @on(Select.Changed, "#default-select")
    def on_default_changed(self, event: Select.Changed) -> None:
        if event.value is not Select.BLANK:
            self.config["default_browser"] = str(event.value)
            save_config(self.config)

    def action_add_rule(self) -> None:
        def handle(rule: Optional[dict]) -> None:
            if rule:
                self.config["rules"].append(rule)
                save_config(self.config)
                self._refresh_table(keep_cursor=len(self.config["rules"]) - 1)

        self.push_screen(RuleEditScreen(browsers=self.browsers), handle)

    def action_edit_rule(self) -> None:
        table = self.query_one("#rules-table", DataTable)
        idx = table.cursor_row
        if idx < 0 or idx >= len(self.config["rules"]):
            return

        def handle(rule: Optional[dict]) -> None:
            if rule:
                self.config["rules"][idx] = rule
                save_config(self.config)
                self._refresh_table(keep_cursor=idx)

        self.push_screen(
            RuleEditScreen(rule=self.config["rules"][idx], browsers=self.browsers),
            handle,
        )

    def action_delete_rule(self) -> None:
        table = self.query_one("#rules-table", DataTable)
        idx = table.cursor_row
        if idx < 0 or idx >= len(self.config["rules"]):
            return

        rule = self.config["rules"][idx]

        def handle(confirmed: bool) -> None:
            if confirmed:
                self.config["rules"].pop(idx)
                save_config(self.config)
                self._refresh_table(keep_cursor=max(0, idx - 1))

        self.push_screen(
            ConfirmScreen(f"Delete rule '{rule.get('pattern')} → {rule.get('browser')}'?"),
            handle,
        )

    def action_move_up(self) -> None:
        table = self.query_one("#rules-table", DataTable)
        idx = table.cursor_row
        if idx <= 0:
            return
        rules = self.config["rules"]
        rules[idx], rules[idx - 1] = rules[idx - 1], rules[idx]
        save_config(self.config)
        self._refresh_table(keep_cursor=idx - 1)

    def action_move_down(self) -> None:
        table = self.query_one("#rules-table", DataTable)
        idx = table.cursor_row
        if idx >= len(self.config["rules"]) - 1:
            return
        rules = self.config["rules"]
        rules[idx], rules[idx + 1] = rules[idx + 1], rules[idx]
        save_config(self.config)
        self._refresh_table(keep_cursor=idx + 1)

    def action_test_url(self) -> None:
        self.push_screen(TestURLScreen(self.config, self.browsers))

    def action_install(self) -> None:
        def handle(confirmed: bool) -> None:
            if confirmed:
                try:
                    install_as_default()
                    self.query_one("#status-label", Static).update(self._status_text())
                    self.notify("Installed as default browser.")
                except Exception as e:
                    self.notify(f"Install failed: {e}", severity="error")

        self.push_screen(
            ConfirmScreen("Install Browser Dispatch as the system default browser?"),
            handle,
        )

    def action_uninstall(self) -> None:
        if not is_installed():
            self.notify("Not currently installed as default browser.", severity="warning")
            return

        def handle(confirmed: bool) -> None:
            if confirmed:
                try:
                    uninstall_as_default()
                    self.query_one("#status-label", Static).update(self._status_text())
                    self.notify("Uninstalled. Previous browser restored.")
                except Exception as e:
                    self.notify(f"Uninstall failed: {e}", severity="error")

        self.push_screen(
            ConfirmScreen(
                "Uninstall Browser Dispatch and restore the previous default browser?"
            ),
            handle,
        )

    def action_quit_app(self) -> None:
        self.exit()


# =============================================================================
# ENTRY POINT
# =============================================================================

def main() -> None:
    args = sys.argv[1:]

    if not args or args[0] in ("-h", "--help"):
        print("Browser Dispatch — smart URL-to-browser router for Linux")
        print()
        print("Usage:")
        print("  browser-dispatch --config          Open configuration TUI")
        print("  browser-dispatch <url>             Dispatch URL to configured browser")
        print()
        print(f"Config file : {CONFIG_PATH}")
        print(f"Desktop file: {DESKTOP_FILE_PATH}")
        return

    first = args[0]

    if first in ("--config", "-c", "config"):
        app = BrowserDispatchApp()
        app.run()
        return

    if first.startswith(("http://", "https://", "ftp://", "file://")):
        dispatch(first)
        return

    print(f"browser-dispatch: unrecognised argument: {first!r}", file=sys.stderr)
    print("Run with --help for usage.", file=sys.stderr)
    sys.exit(1)


if __name__ == "__main__":
    main()
