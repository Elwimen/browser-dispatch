#!/usr/bin/env python3
"""Browser Dispatch - Route URLs to browsers based on domain rules."""

# =============================================================================
# BOOTSTRAP — must be at the very top, before any third-party imports
# =============================================================================
from pathlib import Path
import sys
import os

SCRIPT_FILE = Path(__file__).resolve()
SCRIPT_DIR = SCRIPT_FILE.parent
VENV_DIR = SCRIPT_DIR / ".venv"
VENV_PYTHON = VENV_DIR / "bin" / "python3"

# Check via sys.prefix: venvs set this to the venv directory, not the system prefix.
# Comparing resolved executable paths is unreliable because venv python3 is often a
# symlink to the same underlying binary as the system python3.
if Path(sys.prefix) != VENV_DIR:
    import subprocess

    if not VENV_PYTHON.exists():
        print("Browser Dispatch: setting up virtual environment...", flush=True)
        subprocess.run(
            [sys.executable, "-m", "venv", str(SCRIPT_DIR / ".venv")],
            check=True,
        )
        # Ensure pip is available, then install dependencies
        subprocess.run(
            [str(VENV_PYTHON), "-m", "ensurepip", "--upgrade"],
            check=False,
            capture_output=True,
        )
        subprocess.run(
            [str(VENV_PYTHON), "-m", "pip", "install", "--upgrade", "pip", "-q"],
            check=False,
            capture_output=True,
        )
        print("Installing textual...", flush=True)
        subprocess.run(
            [str(VENV_PYTHON), "-m", "pip", "install", "textual", "-q"],
            check=True,
        )
        print("Setup complete. Launching...", flush=True)

    os.execv(
        str(VENV_PYTHON),
        [str(VENV_PYTHON), str(SCRIPT_FILE)] + sys.argv[1:],
    )

# =============================================================================
# IMPORTS — now running inside the venv
# =============================================================================
import json
import re
import fnmatch
import subprocess
import configparser
from urllib.parse import urlparse
from typing import Optional

from textual import on
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Container, Horizontal, Vertical, ScrollableContainer
