class ConfirmScreen(ModalScreen[bool]):
    """Simple yes/no confirmation dialog."""

    DEFAULT_CSS = """
    ConfirmScreen {
        align: center middle;
    }
    ConfirmScreen > Container {
        width: 52;
        height: auto;
        border: thick $background 80%;
        background: $surface;
        padding: 1 2;
    }
    ConfirmScreen #confirm-buttons {
        margin-top: 1;
        height: auto;
    }
    ConfirmScreen Button {
        margin-right: 1;
    }
    """

    def __init__(self, message: str) -> None:
        super().__init__()
        self.message = message

    def compose(self) -> ComposeResult:
        with Container():
            yield Label(self.message)
            with Horizontal(id="confirm-buttons"):
                yield Button("Yes", variant="error", id="yes-btn")
                yield Button("No", variant="primary", id="no-btn")

    @on(Button.Pressed, "#yes-btn")
    def confirm_yes(self) -> None:
        self.dismiss(True)

    @on(Button.Pressed, "#no-btn")
    def confirm_no(self) -> None:
        self.dismiss(False)


class RuleEditScreen(ModalScreen[Optional[dict]]):
    """Add or edit a dispatch rule."""

    DEFAULT_CSS = """
    RuleEditScreen {
        align: center middle;
    }
    RuleEditScreen > Container {
        width: 64;
        height: auto;
        border: thick $background 80%;
        background: $surface;
        padding: 1 2;
    }
    RuleEditScreen Label {
        margin-top: 1;
    }
    RuleEditScreen Input {
        margin-top: 0;
    }
    RuleEditScreen Select {
        margin-top: 0;
    }
    RuleEditScreen #edit-buttons {
        margin-top: 1;
        height: auto;
    }
    RuleEditScreen Button {
        margin-right: 1;
    }
    RuleEditScreen #help-text {
        color: $text-muted;
        margin-top: 1;
    }
    """

    def __init__(self, rule: Optional[dict] = None, browsers: Optional[dict] = None) -> None:
        super().__init__()
        self.rule = rule or {}
        self.browsers = browsers or {}

    def compose(self) -> ComposeResult:
        browser_opts = [(name, name) for name in sorted(self.browsers.keys())]
        type_opts = [
            ("Glob  — wildcards like *.example.com", "glob"),
            ("Regex — full regular expressions", "regex"),
        ]
        current_type = self.rule.get("type", "glob")
        current_browser = self.rule.get("browser", browser_opts[0][1] if browser_opts else None)

        with Container():
            yield Label("Pattern:")
            yield Input(
                value=self.rule.get("pattern", ""),
                placeholder="*.example.com  or  ^mail\\.google\\.com$",
                id="pattern-input",
            )
            yield Static(
                "Glob: use * as wildcard (*.google.com matches mail.google.com)\n"
                "Regex: matched against the hostname with re.search()",
                id="help-text",
            )
            yield Label("Pattern type:")
            yield Select(type_opts, value=current_type, id="type-select", allow_blank=False)
            yield Label("Route to browser:")
            if browser_opts:
                yield Select(browser_opts, value=current_browser, id="browser-select", allow_blank=False)
            else:
                yield Static("[red]No browsers detected.[/red]")
            with Horizontal(id="edit-buttons"):
                yield Button("Save", variant="primary", id="save-btn")
                yield Button("Cancel", id="cancel-btn")

    @on(Button.Pressed, "#cancel-btn")
    def cancel(self) -> None:
        self.dismiss(None)

    @on(Button.Pressed, "#save-btn")
    def save(self) -> None:
        pattern = self.query_one("#pattern-input", Input).value.strip()
        if not pattern:
            self.query_one("#pattern-input", Input).focus()
            return

        type_select = self.query_one("#type-select", Select)
        rule_type = str(type_select.value) if type_select.value is not Select.BLANK else "glob"

        try:
            browser_select = self.query_one("#browser-select", Select)
            browser = str(browser_select.value) if browser_select.value is not Select.BLANK else ""
        except Exception:
            browser = ""

        if not browser:
            return

        # Validate regex if applicable
        if rule_type == "regex":
            try:
                re.compile(pattern)
            except re.error as e:
                self.notify(f"Invalid regex: {e}", severity="error")
                return

        self.dismiss({"pattern": pattern, "type": rule_type, "browser": browser})


class TestURLScreen(ModalScreen[None]):
    """Test URL routing interactively."""

    DEFAULT_CSS = """
    TestURLScreen {
        align: center middle;
    }
    TestURLScreen > Container {
        width: 64;
        height: auto;
        border: thick $background 80%;
        background: $surface;
        padding: 1 2;
    }
    TestURLScreen #result {
        margin-top: 1;
        padding: 1;
        background: $boost;
        min-height: 3;
    }
    TestURLScreen #close-btn {
        margin-top: 1;
    }
    """

    def __init__(self, config: dict, browsers: dict) -> None:
        super().__init__()
        self._config = config
        self._browsers = browsers

    def compose(self) -> ComposeResult:
        with Container():
            yield Label("Test URL Routing")
            yield Label("Enter a URL to see which browser would handle it:")
            yield Input(placeholder="https://mail.google.com", id="url-input")
            yield Static("", id="result")
            yield Button("Close", id="close-btn")

    def on_mount(self) -> None:
        self.query_one("#url-input", Input).focus()

    @on(Input.Changed, "#url-input")
    def on_url_changed(self, event: Input.Changed) -> None:
        url = event.value.strip()
        result = self.query_one("#result", Static)

        if not url:
            result.update("")
            return

        if not url.startswith(("http://", "https://", "ftp://")):
            url = "https://" + url

        browser_name, matched_rule = match_url(url, self._config)
        try:
            hostname = urlparse(url).hostname or url
        except Exception:
            hostname = url

        if matched_rule:
            result.update(
                f"[bold green]→ {browser_name}[/bold green]\n"
                f"  Hostname: {hostname}\n"
                f"  Matched rule: [italic]{matched_rule['pattern']}[/italic] ({matched_rule['type']})"
            )
        elif browser_name:
            result.update(
                f"[bold yellow]→ {browser_name}[/bold yellow]  (default)\n"
                f"  Hostname: {hostname}\n"
                f"  No rules matched — using default browser"
            )
        else:
            result.update("[bold red]→ No browser configured![/bold red]\n  Set a default browser.")

    @on(Button.Pressed, "#close-btn")
    def close(self) -> None:
        self.dismiss(None)


